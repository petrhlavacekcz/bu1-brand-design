  "logo": {
    "minHeight": "24px",
    "families": [
      {"id": "bu1sport-long", "label": "BU1SPORT Long", "variants": ["white-on-black", "black-on-white", "white-on-hot-rose", "hot-rose-on-black"]},
      {"id": "bu1sport-znak", "label": "BU1SPORT Znak", "variants": ["white-on-black", "black-on-white", "white-on-hot-rose"]},
      {"id": "bu1-znak", "label": "BU1 Znak", "variants": ["white-on-black", "black-on-white", "white-on-hot-rose"]}
    ],
    "forbidden": ["distort", "rotate", "recombine", "apply effects", "use unapproved colors", "generative redraw", "product-accent recolor"],
    "aiRule": "Logo is a deterministic asset, never a prompt-generated element."
  },
  "semantic": {
    "error": {"value": "#C0392B", "light": "#FDECEA", "dark": "#7B241C", "text": "#FFFFFF", "usage": ["form validation", "destructive actions", "system errors"], "wcag": "4.5:1 on white"},
    "success": {"value": "#1E7E34", "light": "#E8F5E9", "dark": "#145523", "text": "#FFFFFF", "usage": ["confirmations", "completed states", "positive feedback"], "wcag": "5.1:1 on white"},
    "warning": {"value": "#B7590A", "light": "#FFF3E0", "dark": "#7D3C07", "text": "#FFFFFF", "usage": ["cautions", "non-blocking alerts", "degraded states"], "wcag": "4.6:1 on white"},
    "info": {"value": "#0369A1", "light": "#E0F2FE", "dark": "#024671", "text": "#FFFFFF", "usage": ["informational messages", "help text", "neutral system status"], "wcag": "5.9:1 on white"}
  },
  "motion": {
    "duration": {"instant": "80ms", "fast": "150ms", "base": "200ms", "slow": "300ms", "slower": "500ms"},
    "easing": {"standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)", "emphasized": "cubic-bezier(0.2, 0, 0, 1.4)"},
    "principles": ["Motion supports hierarchy, not decoration.", "Enter animations use ease-out — content arrives calmly.", "Exit animations use ease-in — content leaves decisively.", "Interactive feedback must complete within 200ms.", "Always respect prefers-reduced-motion."]
  },
  "expressions": {
    "storefront": {
      "northStar": "Scéna pro jediného hrdinu",
      "surface": "monochrome-editorial-commerce",
      "displayFont": "Anton",
      "bodyFont": "Nunito Sans",
      "foundation": ["#111110", "#FFFFFF", "#F1F1EF", "#E2E2DF"],
      "primaryCommerceCta": "#111110",
      "checkoutCta": "#D2147C",
      "productAccent": "optional-local",
      "radiusDefault": "0",
      "cardShadow": "none",
      "gradients": "forbidden"
    },
    "campaignEditorial": {
      "inherits": "storefront",
      "canBeLouder": true,
      "exactProductRequiredWhenVisible": true,
      "exactLogoAssetRequiredWhenVisible": true,
      "productAccent": "optional-one-color",
      "preferredProductionModes": ["manual_product_exact", "product_composite", "product_exact"]
    }
  },
  "usageRules": {
    "productFirst": true,
    "quietInterface": true,
    "primaryCtaDominant": true,
    "expressCheckoutSecondary": true,
    "maxBadgesPerProduct": 2,
    "gradients": "forbidden",
    "hotRoseIsMandatory": false,
    "productAccentIsGlobalUi": false,
    "exactProductForBrandedCreative": true,
    "exactLogoForBrandedCreative": true
  }
