    },
    "body": {
      "family": "Nunito Sans",
      "fallback": ["Arial", "sans-serif"],
      "weights": [400, 600, 700, 800],
      "case": "sentence",
      "usage": ["body", "ui", "description", "price", "labels", "buttons"]
    },
    "expressionRouting": {
      "core": ["Oswald", "Nunito Sans"],
      "storefront": ["Anton", "Nunito Sans"],
      "campaign-editorial": ["Anton", "Nunito Sans"],
      "rule": "Never mix Anton and Oswald on the same surface."
