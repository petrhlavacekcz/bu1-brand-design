    "primaryButton": {
      "minHeight": "52px",
      "paddingX": "24px",
      "border": "1px solid",
      "radius": "0",
      "states": {
        "default": {"background": "#111110", "border": "#111110", "text": "#FFFFFF"},
        "hover": {"background": "#282828", "border": "#282828", "text": "#FFFFFF", "transition": "150ms ease"},
        "focus": {"background": "#111110", "border": "#111110", "text": "#FFFFFF", "outline": "3px #D2147C", "offset": "2px"},
        "active": {"background": "#282828", "border": "#282828", "text": "#FFFFFF", "transform": "translateY(1px)", "transition": "80ms"},
        "disabled": {"background": "#E2E2DF", "border": "#E2E2DF", "text": "#8A8A85"}
      }
    },
    "checkoutButton": {
      "minHeight": "52px",
      "paddingX": "24px",
