      "weights": [400, 600, 700],
      "case": "uppercase",
      "usage": ["core-brand", "legacy-content-surfaces"]
    },
    "storefrontDisplay": {
      "family": "Anton",
      "fallback": ["Arial Narrow", "sans-serif"],
